# Model Base URLs, model names and API keys are configured in the website settings.
# Optional server startup configuration:
AI_FLOW_PORT=4173
AI_FLOW_DATA_DIR=./data

# Required access password. Set this before starting; changing it revokes all sessions.
APP_ACCESS_PASSWORD=
# Optional: true for HTTPS deployments. Defaults to HTTPS / X-Forwarded-Proto detection.
# APP_COOKIE_SECURE=true

# Administrator-only COS configuration. Never exposed by website settings.
# Set true only after filling all four values below. Restart after changes.
COS_ENABLED=false
COS_SECRET_ID=
COS_SECRET_KEY=
COS_BUCKET=
COS_REGION=ap-guangzhou
# The app manages a 2-day deletion rule ONLY for image-video-flow/temp/.
# Reserve that prefix for this app. Signed download URLs last 24 hours.
# Required permissions: GetBucketLifecycle, PutBucketLifecycle, PutObject,
# HeadObject, GetObject. Keep the bucket private; use STANDARD storage.
